# Joined bots/teams/Boss product candidate; NEVER include credentials in VITE_*.
# HTTP API paths are same-origin; WEBUI_BASE_URL is empty in inspected source.
VITE_STARLI_SOCKET_URL=
VITE_STARLI_SOCKET_PATH=/ws/socket.io
# Build-time aliases consumed by routes/+page.ts. Enable only after matching native routes are ready.
VITE_PUBLIC_STARLI_BOSS_INTAKE_ENABLED=false
VITE_PUBLIC_STARLI_GROKBOT1_WIRE_ENABLED=false
# The same flags can be operator-injected as PUBLIC_STARLI_* booleans through
# window.__STARLI_RUNTIME_CONFIG__; a static env file alone does not inject that object.
