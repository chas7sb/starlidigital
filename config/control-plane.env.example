# Merge with platform environment; use same DATABASE_PATH.
NODE_ENV=development
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=4120
CONTROL_PLANE_UPSTREAM_URL=http://127.0.0.1:4100/health
CONTROL_PLANE_DB_PATH=./data/control-plane.sqlite
DATABASE_PATH=./server/data/starli.sqlite
STARLI_WORKSPACE_ROOT=./workspace
CONTROL_PLANE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configure a BYO issuer and JWKS before authenticated use.
# Empty issuer falls back to the production issuer in current source: see docs.
CONTROL_PLANE_OAUTH_ISSUER=
CONTROL_PLANE_OAUTH_AUDIENCE=starli-mcp
CONTROL_PLANE_JWKS_URI=
CONTROL_PLANE_PUBLIC_RESOURCE_URL=http://127.0.0.1:4120/mcp
# Dev token alone DOES NOT activate fixture auth with current parseConfig.
CONTROL_PLANE_DEV_TOKEN=
STARLI_INFERENCE_BASE_URL=
STARLI_INFERENCE_API_KEY=
PLAUSIBLE_BASE_URL=
PLAUSIBLE_API_KEY=
