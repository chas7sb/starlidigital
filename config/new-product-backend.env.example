# Names consumed by the joined native chat launcher; no live demo config is supplied.
# Fresh instance nonce and BYO private key FILE must be provisioned locally by the installer.
STARLI_INSTANCE_NONCE=
STARLI_PRIVATE_OPENROUTER_KEY_FILE=
# Optional reviewed preview controller. Leave blank until provisioned.
STARLI_PREVIEW_CONTROLLER_URL=
STARLI_PREVIEW_CONTROL_KEY=
# Current source launcher ALSO requires --root, --origin, --port.
# Hardcoded release paths, UID997 and disposable /tmp root guards require reviewed source adaptation.
