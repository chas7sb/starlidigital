# Dashboard process only; keep separate from Node platform environment.
ENV=dev
WEBUI_AUTH=true
WEBUI_NAME=StarliDigital
WEBUI_URL=http://localhost:8080
DATA_DIR=./data
# Generate a private stable secret before startup. Do not commit it.
WEBUI_SECRET_KEY=
ENABLE_PERSISTENT_CONFIG=false
ENABLE_SIGNUP=false
CORS_ALLOW_ORIGIN=http://localhost:8080
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
STORAGE_PROVIDER=local
ENABLE_COMMUNITY_SHARING=false
ENABLE_GOOGLE_DRIVE_INTEGRATION=false
ENABLE_ONEDRIVE_INTEGRATION=false
STARLI_COMPANY_MESSAGING_ENABLED=false
# Explicit portable paths; source owners must wire remaining hardcoded production paths.
STARLI_SOURCE_DATABASE=../platform/server/data/starli.sqlite
STARLI_STATE_DIR=./data/starli-state
STARLI_TASK_HOME=./data/tasks
STARLI_RUNTIME_CODE_DIR=./scripts/starli-runtime
STARLI_PLATFORM_SOURCE_ROOT=../platform
STARLI_COMPANY_DATABASE=./data/company.sqlite
STARLI_COMPANY_BOT_DATABASE=./data/company-bot.sqlite
STARLI_MEMORY_ROOT=./data/memory
STARLI_COMPANY_COMPUTER_CONFIG=
STARLI_INFERENCE_BASE_URL=
STARLI_INFERENCE_API_KEY=

# Portable backend configuration (dashboard working directory).
STARLI_CONFIG_DIR=../config/private
STARLI_RUNTIME_BUNDLE_DIR=../runtime/vendor
STARLI_WORKSPACE_ROOT=../workspace
STARLI_PUBLIC_ORIGIN=http://localhost:8080
STARLI_PLATFORM_ORIGIN=http://127.0.0.1:4100
STARLI_CONTROL_PLANE_ORIGIN=http://127.0.0.1:4120
STARLI_ALLOWED_ORIGINS=http://localhost:8080
# Empty executable overrides use PATH discovery.
STARLI_NODE_BINARY=
STARLI_COMPANY_PLATFORM_ORIGIN=http://127.0.0.1:4100
STARLI_PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:4100
STARLI_CONTROL_PLANE_PUBLIC_ORIGIN=http://127.0.0.1:4120
