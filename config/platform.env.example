# Load into the platform process environment. Paths resolve from its working directory.
# Empty secrets intentionally leave integrations unavailable. Never reuse production data.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:4100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY=false
DATABASE_PATH=./server/data/starli.sqlite
ASSET_STORAGE_DIR=./data/assets/generated
VIDEO_STORAGE_DIR=./data/video
PYTHON_BIN=python
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_RECOVERY_EMAIL=
STARLI_AI_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_BUILD_MODEL=
OPENAI_BLOG_MODEL=
OPENAI_OPERATOR_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_IMAGE_MODEL=
OPENROUTER_API_KEY=
ENABLE_IMAGE_GENERATION=false
ENABLE_MARKET_RESEARCH=false
NEXT_WORKER_ENABLED=false
ENABLE_AUTO_FULFILLMENT=false
STRIPE_LIVE_ENABLED=false
DOMAIN_PURCHASE_ENABLED=false
