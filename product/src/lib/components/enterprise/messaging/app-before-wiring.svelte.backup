<script lang="ts">
 import {onMount,onDestroy,tick} from 'svelte';
 import {listNativeCompanies,activateNativeCompany} from '$lib/utils/company-bootstrap';
 import {parseNativeAuthority,projectNativeDirectory} from '$lib/utils/company-authority';
 import {CompanyClient} from '$lib/utils/company-workspace';
 import {verifiedCompanyTurn,companyTurnPath,turnFinished,type CompanyTurn} from '$lib/utils/company-turn';
 import BotsDirectory from '$lib/components/enterprise/BotsDirectory.svelte';
 import PanelWorkspace from '$lib/components/enterprise/PanelWorkspace.svelte';
 import Profile from '$lib/components/enterprise/Profile.svelte';
 import CompanyApps from '$lib/components/enterprise/CompanyApps.svelte';
 import CompanyProjects from '$lib/components/enterprise/CompanyProjects.svelte';
 import ToolPicker from '$lib/components/enterprise/ToolPicker.svelte';
 import AddBot from '$lib/components/enterprise/agents/AddBot.svelte';
 import AgentSettings from '$lib/components/enterprise/agents/AgentSettings.svelte';
 import Orb from '$lib/components/enterprise/Orb.svelte';import Activity from '$lib/components/enterprise/Activity.svelte';
 let actor:any=null,company:any=null,bots:any[]=[],people:any[]=[],bot:any=null,room:any=null,messages:any[]=[],turns:Record<string,CompanyTurn>={};
 let selectedSettingsBotId='';
 let accountMenu=false;
 $: canAdminCompany=company?.scope?.capabilities?.includes('roles.manage')===true&&['owner','admin'].includes(company?.role);
 async function openCompanyAdmin(){accountMenu=false;if(await verifyCompany()&&canAdminCompany){view='CompanyAdmin';menu=false;}}
 let liveTexts:Record<string,string>={};
 let selectedResource:any=null;
 let openPanels:any[]=[],activePanelKey='',panelsMinimized=false;
 function registerPanel(key:string,title:string,component:any,props:any){
  if(!openPanels.some(panel=>panel.key===key))openPanels=[...openPanels,{key,title,component,props}];
  activePanelKey=key;panelsMinimized=false;
 }
 function closePanel(key:string){openPanels=openPanels.filter(panel=>panel.key!==key);if(activePanelKey===key)activePanelKey=openPanels.at(-1)?.key||'';}

 let ResourcePane:any=null;
 let FilePicker:any=null;
 let pickerKinds:string[]=['file','knowledge'];
 let showFiles=false;
 let showActions=false,showTools=false;
 let auxiliaryPane:any=null,auxiliaryKind='',browserTurn:CompanyTurn|null=null;
 async function openWorkspacePane(kind:string){
  if(!company)return;
  const companyId=company.id,currentToken=token;
  const turn=Object.values(turns).filter(t=>t.botId===bot?.id).slice(-1)[0];
  if(kind==='browser'&&!turn){error='Ask the bot to open a website first. Its browser will appear alongside that task.';showActions=false;return;}
  const component=kind==='computer'?(await import('$lib/components/enterprise/panes/ComputerWorkspacePane.svelte')).default:(await import('$lib/components/enterprise/panes/BrowserWorkspacePane.svelte')).default;
  if(company?.id!==companyId||token!==currentToken)return;
  showActions=false;showFiles=false;browserTurn=turn||null;auxiliaryKind=kind;registerPanel(kind==='computer'?'computer':kind+':'+turn.runId,kind==='computer'?'Computer':'Browser',component,kind==='computer'?{}:{roomId:turn.conversationId,botId:turn.botId,runId:turn.runId});
 }

 async function toggleFiles(){
  if(!company)return;
  if(!FilePicker)FilePicker=(await import('$lib/components/enterprise/panes/CompanyFiles.svelte')).default;
  showFiles=!showFiles;
 }
 async function openResource(ref:any){
  if(!company||ref?.scope!=='company'||ref.ownerId!==company.id||!['file','knowledge','project','task','sheet','email'].includes(ref.kind)||typeof ref.id!=='string')return;
  const identity=company.id,currentToken=token;
  const pane=['task','sheet','email'].includes(ref.kind)?(await import('$lib/components/enterprise/panes/StructuredResourcePane.svelte')).default:(await import('$lib/components/enterprise/panes/FileWorkspacePane.svelte')).default;
  if(company?.id!==identity||token!==currentToken)return;
  ResourcePane=pane;selectedResource=null;registerPanel(ref.kind+':'+ref.id,ref.title||ref.kind.charAt(0).toUpperCase()+ref.kind.slice(1),pane,{resource:ref});showFiles=false;
 }

 let channels:any[]=[],channel:any=null,dispatchBot='';
 let token='',email='',password='',draft='',error='',loading=true,sending=false,signing=false,stopping=false,view='Bots',menu=false;
 let client:CompanyClient|null=null,ctrl=new AbortController(),epoch=0,reading=false,timer:ReturnType<typeof setInterval>,refreshTimer:ReturnType<typeof setTimeout>,scroller:HTMLElement,stick=true;
 let pending:{key:string,fingerprint:string}|null=null;const drafts=new Map<string,string>(),writeKeys=new Map<string,string>(),enc=encodeURIComponent;
 const draftKey=()=>channel?'channel:'+channel.id:bot?'bot:'+bot.id:'';
 $: active=Object.values(turns).filter(t=>!turnFinished(t.status));$: working=active.length>0;$: index=Math.max(0,bots.findIndex(b=>b.id===bot?.id));
 async function api(path:string,signal=ctrl.signal,options:RequestInit={}){const current=token,lifecycle=ctrl;const r=await fetch(path,{...options,signal,credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json',...(current?{Authorization:'Bearer '+current}:{}),...(options.body?{'Content-Type':'application/json'}:{}),...options.headers}});if(signal.aborted||lifecycle!==ctrl||token!==current)throw new DOMException('Session changed','AbortError');if(!r.ok){
 let message=r.status===401?'Please sign in to continue.':r.status===403?'Access to this company resource is unavailable.':'Request failed (HTTP '+r.status+').';
 if(path==='/api/v1/auths/signin'){
  const detail=await r.json().catch(()=>null);
  if(typeof detail?.detail==='string'&&detail.detail.length<=240)message=detail.detail;
  else if(r.status===400)message='Check your email and password and try again.';
  else if(r.status===429)message='Please wait before trying to sign in again.';
 }
 const e:any=new Error(message);e.status=r.status;throw e;
}if(!r.headers.get('content-type')?.includes('application/json'))throw Error('Unexpected service response.');const data=await r.json();if(signal.aborted||lifecycle!==ctrl||token!==current)throw new DOMException('Session changed','AbortError');return data;}

 function revoke(status:number,message:string){accountMenu=false;openPanels=[];activePanelKey='';panelsMinimized=false;auxiliaryPane=null;showActions=false;showTools=false;browserTurn=null;selectedResource=null;showFiles=false;selectedSettingsBotId='';epoch++;ctrl.abort();client?.close();client=null;ctrl=new AbortController();clearTimeout(refreshTimer);company=null;bots=[];people=[];channels=[];bot=null;channel=null;room=null;messages=[];turns={};liveTexts={};draft='';dispatchBot='';pending=null;drafts.clear();writeKeys.clear();reading=false;sending=false;stopping=false;signing=false;loading=false;menu=false;view='Bots';if(status===401){actor=null;token='';localStorage.removeItem('token');}error=message;}
 async function verifyCompany(version=epoch){if(!company||!actor)return false;const companyId=company.id,actorId=actor.id;let raw;try{raw=await api('/api/v1/companies/'+enc(companyId)+'/capabilities');}catch(e){if(version!==epoch||(e as Error).name==='AbortError')return false;const status=(e as any).status;if([401,403,404].includes(status)){revoke(status,status===401?'Your session expired. Sign in to continue.':'Company access changed. Reload to open an available workspace.');return false;}throw e;}if(version!==epoch)return false;try{const scope=parseNativeAuthority(raw,companyId,actorId);company={...company,scope,role:scope.role,revision:scope.membership_revision};return true;}catch{revoke(403,'Company authority could not be verified. Reload to continue.');return false;}}
 async function accessDenied(status:number,version=epoch){if(version!==epoch)return;if(status===401){revoke(401,'Your session expired. Sign in to continue.');return;}if(![403,404].includes(status))return;try{if(!await verifyCompany(version)||version!==epoch)return;}catch{if(version!==epoch)return;revoke(403,'Access could not be verified. Reload to continue.');return;}if(version!==epoch)return;const key=draftKey();drafts.delete(key);epoch++;room=null;messages=[];turns={};liveTexts={};draft='';dispatchBot='';pending=null;error='This conversation is no longer available. Select another conversation.';}
 async function initialize(){const lifecycle=ctrl;loading=true;error='';try{const who=await api('/api/v1/auths/');if(lifecycle!==ctrl)return;actor=who;const list=await listNativeCompanies(api,ctrl.signal),chosen=list.find(c=>c.name.trim().toLowerCase()==='starlidigital')||list.find(c=>c.name.trim().toLowerCase()==='starlidigital2')||list[0];if(lifecycle!==ctrl)return;if(!chosen){error='No company membership is available.';return;}const selectedCompany=await activateNativeCompany(api,actor.id,chosen,ctrl.signal);if(lifecycle!==ctrl)return;company=selectedCompany;bots=company.directory.filter((x:any)=>x.kind==='bot');people=company.directory.filter((x:any)=>x.kind==='person');client?.close();client=new CompanyClient(company.id,()=>localStorage.token||'',fetch,true);const rooms=await client.request('/rooms');if(lifecycle!==ctrl)return;channels=(rooms.rooms||[]).filter((r:any)=>r.companyId===company.id&&r.kind==='channel');if(bots.length)await choose(bots[0]);else if(channels.length)await chooseChannel(channels[0]);}catch(e){if((e as Error).name==='AbortError')return;if([401,403,404].includes((e as any).status)){revoke((e as any).status,(e as Error).message);return;}error=(e as Error).message;}finally{if(lifecycle===ctrl)loading=false;}}
 async function signin(){if(ctrl.signal.aborted)ctrl=new AbortController();const lifecycle=ctrl;signing=true;error='';try{const d=await api('/api/v1/auths/signin',ctrl.signal,{method:'POST',body:JSON.stringify({email:email.trim(),password})});if(lifecycle!==ctrl)return;if(!d.token)throw Error('No session returned.');token=d.token;localStorage.token=token;password='';await initialize();}catch(e){if(lifecycle===ctrl&&(e as Error).name!=='AbortError')error=(e as Error).message;}finally{if(lifecycle===ctrl)signing=false;}}
 async function choose(b:any){showTools=false;showActions=false;if(auxiliaryKind==='browser'){auxiliaryPane=null;browserTurn=null;}if(draftKey())drafts.set(draftKey(),draft);const version=++epoch;sending=false;stopping=false;channel=null;dispatchBot='';bot=b;draft=drafts.get('bot:'+b.id)||'';room=null;messages=[];turns={};liveTexts={};pending=null;error='';menu=false;try{const r=await client!.request('/rooms','POST',{kind:'dm',visibility:'private',name:b.name,inviteUserIds:[],agentIds:[b.id]},crypto.randomUUID());if(version!==epoch)return;if(r.companyId!==company.id||r.kind!=='dm'||!r.agentIds?.includes(b.id))throw Error('Bot conversation scope could not be verified.');room=r;await refresh(version);}catch(e){if(version===epoch){error=(e as Error).message;await accessDenied((e as any).status,version);}}}

 async function chooseChannel(c:any){showTools=false;showActions=false;if(auxiliaryKind==='browser'){auxiliaryPane=null;browserTurn=null;}if(draftKey())drafts.set(draftKey(),draft);const version=++epoch;channel=c;view='Channel';bot=null;dispatchBot='';draft=drafts.get('channel:'+c.id)||'';room=null;messages=[];turns={};liveTexts={};pending=null;error='';menu=false;try{const r=await client!.request('/rooms/'+enc(c.id));if(version!==epoch)return;if(r.companyId!==company.id||r.kind!=='channel'||r.id!==c.id)throw Error('Channel scope could not be verified.');room=r;await refresh(version);}catch(e){if(version===epoch){error=(e as Error).message;await accessDenied((e as any).status,version);}}}
 async function refresh(version=epoch){if(!company||reading||ctrl.signal.aborted)return;reading=true;const lifecycle=ctrl;try{if(!await verifyCompany(version)||version!==epoch||!room)return;const id=room.id;const r=await client!.request('/rooms/'+enc(id));if(version!==epoch)return;if(r.companyId!==company.id||r.id!==id||(!channel&&!r.agentIds.includes(bot.id)))throw Error('Conversation access changed.');const after=Math.max(0,(Number.isSafeInteger(r.lastMessageSequence)?r.lastMessageSequence:0)-99);const d=await client!.request('/rooms/'+enc(id)+'/messages?after='+after+'&limit=100');if(version!==epoch)return;if(!Array.isArray(d.messages)||d.messages.some((m:any)=>m.roomId!==id))throw Error('Message scope changed.');messages=d.messages;await Promise.all(messages.filter(m=>m.speaker?.kind==='agent'&&m.runId&&!turns[m.id]).map(async m=>{try{const t=verifiedCompanyTurn(await api('/api/v1/starli/companies/'+enc(company.id)+'/rooms/'+enc(id)+'/bots/'+enc(m.speaker.id)+'/runtime/turns/'+enc(m.runId)),company.id,id,m.id);if(t&&version===epoch)turns={...turns,[m.id]:t};}catch{}}));await tick();if(stick&&scroller)scroller.scrollTop=scroller.scrollHeight;}catch(e){if(version===epoch){error=(e as Error).message;await accessDenied((e as any).status,version);}}finally{if(lifecycle===ctrl)reading=false;}}
 async function createdBot(result:any){
 if(!company||result.companyId!==company.id||!result.botId)return;
 const id=company.id,version=epoch;
 try{const raw=await api('/api/v1/companies/'+enc(id)+'/directory');if(version!==epoch||company?.id!==id)return;
 const list=projectNativeDirectory(raw,company.scope);
 if(!Array.isArray(list))throw Error('The company directory could not be refreshed.');
 const next=list.filter((item:any)=>item.kind==='bot');
 if(!next.some((item:any)=>item.id===result.botId))throw Error('The new bot is not visible in the company directory yet. Reload before trying again.');
 bots=next;selectedSettingsBotId=result.botId;view='AgentSettings';
 }catch(e){error=(e as Error).message;}
 }
 function selectBotSettings(detail:{botId:string}){const selected=bots.find(b=>b.id===detail.botId);if(!selected||!company)return;selectedSettingsBotId=selected.id;view='AgentSettings';window.dispatchEvent(new CustomEvent('starli-enterprise-agent-settings',{detail:{companyId:company.id,botId:selected.id,membershipRevision:company.revision}}));}
 function closeAgentSettings(dirty:boolean){
  if(dirty&&!confirm('Discard unsaved agent settings?'))return;
  selectedSettingsBotId='';view='BotDirectory';
 }
 function savedAgentProfile(event:any){
  if(event.companyId!==company?.id||event.botId!==selectedSettingsBotId)return;
  bots=bots.map(item=>item.id===event.botId?{...item,name:event.name}:item);
  if(bot?.id===event.botId)bot={...bot,name:event.name};
 }
 function refreshSoon(){clearTimeout(refreshTimer);refreshTimer=setTimeout(()=>void refresh(),120);}
 function streamContent(value:any){
  const turn=turns[value.assistantMessageId];
  if(!turn||turn.runId!==value.runId||turn.companyId!==company?.id||turn.conversationId!==room?.id||typeof value.text!=='string')return;
  liveTexts={...liveTexts,[value.assistantMessageId]:value.text};
  void tick().then(()=>{if(stick&&scroller)scroller.scrollTop=scroller.scrollHeight;});
 }
 function messageContent(message:any){
  const saved=message.content||'',live=liveTexts[message.id];
  return typeof live==='string'&&live.length>=saved.length&&live.startsWith(saved)?live:saved;
 }
 function state(t:CompanyTurn){if(turns[t.assistantMessageId]?.runId===t.runId)turns={...turns,[t.assistantMessageId]:t};}
 async function send(){if(!draft.trim()||sending||working||!room)return;const raw=draft,content=draft.trim(),id=room.id,b=channel?dispatchBot:bot.id,version=epoch,key=draftKey(),fingerprint=JSON.stringify([id,b,content]);if(!writeKeys.has(fingerprint))writeKeys.set(fingerprint,crypto.randomUUID());pending={key:writeKeys.get(fingerprint)!,fingerprint};sending=true;error='';try{const d=await client!.request('/rooms/'+enc(id)+'/messages','POST',{content,parentId:null,mentions:b?[{kind:'agent',id:b}]:[],dispatchAgentIds:b?[b]:[],attachmentIds:[]},pending.key);if(version!==epoch)return;if(d.message?.roomId!==id)throw Error('Delivery could not be verified.');if(draft===raw){draft='';drafts.delete(key);}pending=null;writeKeys.delete(fingerprint);stick=true;messages=[...messages.filter(m=>m.id!==d.message.id),d.message];for(const entry of d.botDispatch||[]){const t=verifiedCompanyTurn(entry.receipt,company.id,id);if(t&&entry.status==='SUBMITTED')turns={...turns,[t.assistantMessageId]:t};else if(entry.status!=='SUBMITTED')error='Message saved; the bot did not start. Refresh to check its status.';}await refresh(version);}catch(e){if(version===epoch){error=(e as Error).message+' Your draft is kept. Refresh before retrying an unconfirmed delivery.';await accessDenied((e as any).status,version);}}finally{if(version===epoch)sending=false;}}
 async function stop(){if(stopping)return;const version=epoch;stopping=true;error='';try{for(const turn of active){const d=await api(companyTurnPath(turn)+'/cancel',ctrl.signal,{method:'POST'});if(version!==epoch||!company||!room)return;const t=verifiedCompanyTurn(d,company.id,room.id,turn.assistantMessageId);if(t)state(t);}await refresh();}catch(e){if(version===epoch){error=(e as Error).message+' Stop is unconfirmed. Refresh to check the run.';await accessDenied((e as any).status,version);}}finally{if(version===epoch)stopping=false;}}
 function key(e:KeyboardEvent){if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();void send();}}
 function session(e:StorageEvent){if(e.key==='token'||e.key===null){revoke(0,'Your session changed. Sign in to continue.');actor=null;token='';password='';}}
 onMount(()=>{token=localStorage.token||'';if(token)void initialize();else loading=false;timer=setInterval(()=>{if(!document.hidden)void refresh();},2500);window.addEventListener('storage',session);});onDestroy(()=>{ctrl.abort();client?.close();clearInterval(timer);clearTimeout(refreshTimer);window.removeEventListener('storage',session);});
</script>
<svelte:window on:keydown={event=>{if(event.key==='Escape')accountMenu=false;}} on:click={event=>{if(accountMenu&&!(event.target instanceof Element&&event.target.closest('.account-area')))accountMenu=false;}}/>
<svelte:head><title>Starli — Company workspace</title><meta name="color-scheme" content="light"/></svelte:head>
<div class="enterprise">
{#if !actor&&!loading}<main class="signin"><div class="signin-card"><div class="brand"><Orb size={34}/><strong>starli</strong></div><h1>Your company, connected.</h1><p>Sign in to your company workspace.</p><form on:submit|preventDefault={signin}><label>Email<input type="email" autocomplete="username" bind:value={email} required/></label><label>Password<input type="password" autocomplete="current-password" bind:value={password} required/></label><button class="primary" disabled={signing}>{signing?'Signing in…':'Sign in'}</button></form>{#if error}<p class="error" role="alert">{error}</p>{/if}</div></main>
{:else}<aside class:open={menu}><div class="company-pill"><span>{company?.name||'Loading company…'}</span></div><nav aria-label="Company navigation">{#each ['Company','Bots','Projects','Apps','Team'] as item,i}<button class:chosen={view===(item==='Bots'?'BotDirectory':item)} on:click={()=>{view=item==='Bots'?'BotDirectory':item;menu=false;}}><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{#if item==='Company'}<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/>{:else if item==='Bots'}<circle cx="12" cy="12" r="8"/><path d="M8 10h.01M16 10h.01M8 15c2 2 6 2 8 0M12 4V2"/>{:else if item==='Projects'}<path d="m3 7 9-4 9 4-9 4-9-4Zm0 5 9 4 9-4M3 17l9 4 9-4"/>{:else if item==='Team'}<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>{:else}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>{/if}</svg>{item}</button>{/each}</nav><div class="channels"><div class="roster-title">CHANNELS</div>{#each channels as c(c.id)}<button class:chosen={channel?.id===c.id&&view==='Channel'} on:click={()=>void chooseChannel(c)}><span>#</span>{c.name}</button>{:else}<p>No visible company channels.</p>{/each}</div><div class="roster-title">COMPANY BOTS <button class="add-bot-button" aria-label="Add bot" on:click={()=>view='AddBot'}>+</button></div><div class="roster">{#each bots as b,i(b.id)}<button class:selected={view==='Bots'&&bot?.id===b.id} on:click={()=>{view='Bots';void choose(b);}}><Orb index={i} size={29}/><span><strong>{b.name}</strong><small>{b.role||'Company bot'}</small></span></button>{:else}<p>{loading?'Loading bots…':'No company bots available.'}</p>{/each}</div><button class="add-bot-link" on:click={()=>view='AddBot'}>＋ Add a bot</button><div class="account-area">{#if accountMenu}<div class="account-popup" role="menu" aria-label="Account menu"><button role="menuitem" on:click={()=>{accountMenu=false;view='Profile';menu=false;}}>Profile</button>{#if canAdminCompany}<button role="menuitem" on:click={()=>void openCompanyAdmin()}>Company</button>{/if}</div>{/if}<button class="account" aria-label="Open account menu" aria-expanded={accountMenu} aria-haspopup="menu" on:click={()=>accountMenu=!accountMenu}><span class="user-avatar">{actor?.name?.slice(0,1)||'·'}</span><span><strong>{actor?.name||'Loading account…'}</strong><small>{company?.role||'Company workspace'}</small></span><span class="account-more" aria-hidden="true">···</span></button></div></aside>
<main class="workspace"><header><button class="menu" aria-label="Open navigation" on:click={()=>menu=!menu}>☰</button><div class="header-identity">{#if view==='Channel'&&channel}<div><h1><span class="hash">#</span> {channel.name}</h1><p>Company channel{#if working}<span class="working-dot"/>Working{/if}</p></div>{:else if view==='Bots'&&bot}<Orb {index} size={32}/><div><h1>{bot.name}<span class:busy={working} class="presence"><i/>{working?'WORKING':'ONLINE'}</span></h1><p>{bot.role||'Company bot'}{#if working}<span class="working-dot"/>Working{/if}</p></div>{:else}<h1>{view==='BotDirectory'?'Bots':view==='CompanyAdmin'?'Company administration':view==='AddBot'?'Add bot':view==='AgentSettings'?'Bot settings':view}</h1>{/if}</div></header>{#if openPanels.length&&(view==='Bots'||view==='Channel')}<div class="open-panel-rail" aria-label="Open workspace panels">{#each openPanels as panel(panel.key)}<button class:active={!panelsMinimized&&activePanelKey===panel.key} on:click={()=>{activePanelKey=panel.key;panelsMinimized=false;}}>{panel.title}</button>{/each}<button class="minimize" on:click={()=>panelsMinimized=!panelsMinimized}>{panelsMinimized?'Show panels':'Minimize panels'}</button></div>{/if}
{#if view==='CompanyAdmin'&&company&&canAdminCompany}<section class="company-admin section-view"><p class="admin-eyebrow">COMPANY ADMINISTRATION</p><h2>{company.name}</h2><p>Manage your company’s people, AI agent bots, tools and connections.</p><div class="admin-summary"><span><strong>{people.length}</strong> People</span><span><strong>{bots.length}</strong> AI agent bots</span><span><strong>{channels.length}</strong> Channels</span></div><div class="admin-actions"><button on:click={()=>view='Team'}>People and team <span>View company members →</span></button><button on:click={()=>view='BotDirectory'}>AI agent bots <span>Profiles, models and permissions →</span></button><button on:click={()=>view='Apps'}>Connections and MCP <span>Manage tools and resources →</span></button></div><h3>Your company access</h3><div class="admin-caps">{#each company.scope.capabilities as capability}<span>{capability}</span>{/each}</div></section>{:else if view==='Profile'&&actor&&company}<Profile {actor} companyName={company.name} accessSignal={ctrl.signal} on:close={()=>view='Bots'} on:denied={event=>void accessDenied(event.detail.status)}/>{:else if view==='AddBot'&&company}
<AddBot companyId={company.id} companyName={company.name} membershipRevision={company.revision} accessSignal={ctrl.signal} on:created={event=>void createdBot(event.detail)} on:close={event=>{if(!event.detail.dirty||confirm('Leave bot creation?'))view='BotDirectory';}} on:accesschanged={event=>void accessDenied(event.detail.status)}/>
{:else if view==='AgentSettings'&&company&&selectedSettingsBotId}
 {#key company.id+':'+selectedSettingsBotId}<AgentSettings companyId={company.id} botId={selectedSettingsBotId} botName={bots.find(item=>item.id===selectedSettingsBotId)?.name||''} membershipRevision={company.revision} accessSignal={ctrl.signal} on:close={event=>closeAgentSettings(event.detail.dirty)} on:saved={event=>savedAgentProfile(event.detail)} on:accesschanged={event=>void accessDenied(event.detail.status)}/>{/key}
{:else if view==='Projects'&&company&&actor}<CompanyProjects companyId={company.id} actorId={actor.id} accessSignal={ctrl.signal} on:open={event=>void openResource(event.detail)} on:denied={event=>void accessDenied(event.detail.status)}/>{:else if view==='Apps'&&company&&actor}<CompanyApps companyId={company.id} actorId={actor.id} accessSignal={ctrl.signal} on:denied={event=>void accessDenied(event.detail.status)} on:tool={event=>{view='Bots';draft='Use '+event.detail.toolName+' to ';}} on:resource={event=>{view='Bots';void toggleFiles(event.detail.kinds||[]);}}/>{:else if view==='BotDirectory'}<BotsDirectory {bots} selectedId={selectedSettingsBotId} on:select={e=>selectBotSettings(e.detail)}/>{:else if view==='Bots'||view==='Channel'}<div class="chat-scroll" bind:this={scroller} on:scroll={()=>stick=scroller.scrollHeight-scroller.scrollTop-scroller.clientHeight<90}><div class="chat-column" role="log" aria-live="polite">{#if !messages.length&&(!room||loading)}<div class="empty"><Orb {index} size={48}/><h2>{loading?'Opening your workspace':channel?'Start the conversation':bot?'What can we move forward?':'No bots available'}</h2><p>{channel?'Messages in #'+channel.name+'.':bot?'Start a conversation with '+bot.name+'.':loading?'Loading your company and bots.':'Your company directory has no accessible bots.'}</p></div>{/if}{#each messages as m(m.id)}<article class:human={m.speaker?.kind==='human'&&m.speaker.id===actor?.id}>{#if m.speaker?.kind==='agent'}<div class="speaker"><Orb {index} size={22}/><strong>{bots.find(b=>b.id===m.speaker.id)?.name||bot?.name||'Company bot'}</strong></div>{:else if m.speaker?.id!==actor?.id}<div class="speaker"><span class="user-avatar">{people.find(p=>p.id===m.speaker?.id)?.name?.slice(0,1)||'�'}</span><strong>{people.find(p=>p.id===m.speaker?.id)?.name||'Company member'}</strong></div>{/if}<div class="message-text">{m.deleted?'Message deleted':messageContent(m)}</div>{#if turns[m.id]}{#key turns[m.id].runId}<Activity accessSignal={ctrl.signal} turn={turns[m.id]} on:denied={e=>void accessDenied(e.detail.status)} on:content={event=>streamContent(event.detail)} on:refresh={refreshSoon} on:state={e=>state(e.detail)}/>{/key}{/if}</article>{/each}{#each active.filter(t=>!messages.some(m=>m.id===t.assistantMessageId)) as turn(turn.runId)}<article><div class="speaker"><Orb {index} size={22}/><strong>{bots.find(b=>b.id===turn.botId)?.name||'Company bot'}</strong></div><div class="message-text">{liveTexts[turn.assistantMessageId]||''}</div><Activity accessSignal={ctrl.signal} {turn} on:denied={e=>void accessDenied(e.detail.status)} on:content={event=>streamContent(event.detail)} on:refresh={refreshSoon} on:state={e=>state(e.detail)}/></article>{/each}</div></div><div class="composer-area"><div class="composer-column">{#if showTools&&company&&bot&&room}{#key company.id+':'+bot.id+':'+room.id}<ToolPicker companyId={company.id} botId={bot.id} conversationId={room.id} accessSignal={ctrl.signal} on:close={()=>showTools=false} on:select={event=>{draft=(draft?draft+'\n':'')+'Use '+event.detail.name+' to ';showTools=false;}}/>{/key}{/if}{#if showActions}<div class="chat-actions" role="group" aria-label="Chat tools">{#if bot&&room}<button type="button" on:click={()=>{showActions=false;showTools=true;}}>Bot tools <small>Browse available tools and MCP capabilities</small></button>{/if}<button type="button" on:click={()=>{showActions=false;void toggleFiles();}}>Files and documents <small>Open or upload company files</small></button><button type="button" on:click={()=>void openWorkspacePane('computer')}>Starli Computer <small>Watch the company desktop</small></button><button type="button" on:click={()=>void openWorkspacePane('browser')}>AI browser <small>Open the browser for this bot’s task</small></button><button type="button" on:click={()=>{showActions=false;view='Apps';}}>Tools and connections <small>Manage MCP servers and integrations</small></button></div>{/if}{#if showFiles&&FilePicker&&company}<svelte:component this={FilePicker} companyId={company.id} actorId={actor.id} accessSignal={ctrl.signal} kinds={pickerKinds} on:open={event=>void openResource(event.detail)} on:close={()=>showFiles=false}/>{/if}{#if error}<div class="error" role="alert">{error}<button on:click={()=>void refresh()}>Refresh</button></div>{/if}<form class="composer" on:submit|preventDefault={send}><textarea aria-label={channel?'Message #'+channel.name:'Message '+(bot?.name||'bot')} bind:value={draft} on:keydown={key} placeholder={channel?'Message #'+channel.name+'…':bot?'Message '+bot.name+'…':'Select a bot to begin'} rows="2" disabled={!room||sending}/><div class="composer-footer"><button class="file-toggle" type="button" aria-label="Open chat tools" aria-expanded={showActions} on:click={()=>showActions=!showActions}>+</button>{#if channel}<label class="bot-dispatch"><span class="sr-only">Ask a bot</span><select aria-label="Ask a bot" bind:value={dispatchBot} disabled={sending||working}><option value="">@ Ask a bot (optional)</option>{#each bots.filter(b=>room?.agentIds?.includes(b.id)) as b}<option value={b.id}>@{b.name}</option>{/each}</select></label>{:else}<span class="composer-spacer"/>{/if}{#if working}<button class="stop" type="button" disabled={stopping} on:click={stop}>{stopping?'Stopping…':'■ Stop'}</button>{:else}<button class="send" aria-label="Send message" disabled={!room||!draft.trim()||sending}>{sending?'…':'↑'}</button>{/if}</div></form><p class="disclaimer">{bot?.name||'Starli'} uses your company context. Review important work.</p></div></div>
{:else}<section class="section-view"><h2>{view==='Company'?company?.name||'Company':view}</h2>{#if view==='Team'}<p>People in your company</p>{#each people as person}<div class="person-row"><span class="user-avatar">{person.name.slice(0,1)}</span><strong>{person.name}</strong>{#if person.role}<small>{person.role}</small>{/if}</div>{:else}<p>No visible team members.</p>{/each}{:else if view==='Company'}<p>Your workspace connects {bots.length} company bots and {people.length} people.</p><button class="primary" on:click={()=>view='Bots'}>Open bot conversations</button>{:else}<p>{view} are not connected to this local workspace yet.</p>{/if}</section>{/if}</main>{#if company&&actor}<PanelWorkspace panels={openPanels} activeKey={activePanelKey} minimized={panelsMinimized} companyId={company.id} actorId={actor.id} accessSignal={ctrl.signal} on:select={event=>{activePanelKey=event.detail.key;panelsMinimized=false;}} on:minimize={()=>panelsMinimized=true} on:close={event=>closePanel(event.detail.key)} on:denied={event=>void accessDenied(event.detail.status||403)}/>{/if}{/if}
</div>
<style>
.composer-column{position:relative}.composer-footer{gap:10px}.composer-footer .send,.composer-footer .stop{margin-left:auto}.file-toggle{background:none;border:0;color:#7083a4;font-size:22px;width:26px;padding:0;line-height:1;flex:none}

:global(body){margin:0;background:#fff!important}.enterprise{--enterprise-primary:#3466f6;--enterprise-border:#e6ebf4;--enterprise-muted:#71809a;--enterprise-surface:#fff;--enterprise-on-primary:#fff;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#292c32;background:#fff;display:flex;height:100dvh;width:100%;font-size:14px;line-height:1.5}.enterprise :global(button),.enterprise :global(input),.enterprise :global(textarea){font:inherit}.enterprise :global(button){cursor:pointer}.enterprise :global(button:disabled){cursor:default;opacity:.45}.enterprise :global(button:focus-visible),.enterprise :global(textarea:focus-visible),.enterprise :global(input:focus-visible){outline:2px solid #6196f4;outline-offset:3px}aside{width:194px;flex:none;display:flex;flex-direction:column;padding:24px 12px 16px;background:#f6f7f9;border-right:1px solid #eceef1}.brand{display:flex;align-items:center;gap:9px;color:#1f2531;text-decoration:none;padding:0 9px;font-size:24px;letter-spacing:-1px}.brand strong{font-weight:650}.company-pill{display:flex;align-items:center;gap:8px;border:1px solid #e5e7ec;background:#fff;border-radius:8px;padding:9px 8px;margin:58px 0 23px;font-size:12px;font-weight:600;min-width:0}.company-pill>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}nav{display:flex;flex-direction:column;gap:3px}nav button{display:flex;gap:12px;align-items:center;padding:10px 12px;background:transparent;border:0;border-radius:7px;text-align:left;color:#747b88;font-size:13px}nav button.chosen{background:#e9edf4;color:#353c4b;font-weight:600}.nav-icon{width:20px;height:20px;flex:none}.roster-title{display:flex;justify-content:space-between;font-size:9px;letter-spacing:1px;font-weight:650;color:#989eaa;margin:30px 10px 13px}.roster{overflow:auto;flex:1;min-height:0}.roster>button{display:flex;align-items:center;gap:9px;padding:10px 8px;text-align:left;border:0;border-radius:8px;width:100%;background:transparent}.roster>button.selected{background:#e9edf4}.roster strong,.account strong{font-size:11px;font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:112px}.roster small,.account small{display:block;font-size:9px;color:#9197a3;margin-top:1px}.roster>p{font-size:11px;color:#9197a3;padding:8px}.account{border-top:1px solid #e8ebf0;padding:17px 7px 0;display:flex;align-items:center;gap:8px}.user-avatar{height:28px;width:28px;border-radius:50%;background:#e2e7ef;color:#788297;display:grid;place-items:center;font-size:11px;flex:none}.workspace{flex:1;min-width:0;display:flex;flex-direction:column}.workspace>header{height:72px;flex:none;border-bottom:1px solid #eff0f3;padding:0 35px;display:flex;align-items:center;justify-content:space-between;gap:15px}.header-identity{display:flex;align-items:center;gap:10px}.header-identity h1{font-size:13px;font-weight:600;margin:0}.header-identity p{font-size:10px;color:#989da7;margin:2px 0 0;display:flex;align-items:center;gap:7px}.working-dot{height:5px;width:5px;background:#6199d5;border-radius:50%;margin-left:4px}.chat-scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain}.chat-column{max-width:680px;margin:auto;padding:45px 26px 20px;min-height:100%}article{margin:0 0 30px;font-size:13px;line-height:1.85;overflow-wrap:anywhere}.speaker{display:flex;align-items:center;gap:8px;margin-bottom:10px}.speaker strong{font-size:11px;font-weight:600}.message-text{white-space:pre-wrap}.human{display:flex;flex-direction:column;align-items:flex-end;margin:0 0 30px}.human .message-text{max-width:88%;background:#f1f3f6;border-radius:15px 15px 3px 15px;padding:10px 16px;color:#474d58;font-size:12px}.composer-area{flex:none;padding:14px 26px 16px;background:#fff}.composer-column{max-width:628px;margin:auto}.composer{border:1px solid #e3e6ec;border-radius:14px;padding:14px 15px 10px;box-shadow:0 3px 13px #22304b05}.composer textarea{width:100%;resize:none;border:0;background:transparent;outline:none;color:#333c4c;min-height:48px;font-size:12px;line-height:1.7}.composer textarea::placeholder{color:#a3a8b2}.composer-footer{display:flex;align-items:center;justify-content:space-between}.composer-footer>span{font-size:9px;color:#adb2bd}.send{background:#5485e7;border:0;color:#fff;border-radius:8px;height:29px;width:30px;font-size:21px}.stop{background:#edf2fc;border:0;color:#4d75b9;padding:5px 10px;border-radius:7px;font-size:11px}.disclaimer{color:#b2b6bf;font-size:9px;text-align:center;margin:10px 0 0}.empty{min-height:42vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;color:#969da9}.empty h2{font-size:19px;font-weight:500;color:#444e60;margin:18px 0 6px;letter-spacing:-.4px}.empty p{font-size:12px;margin:0}.error{font-size:12px;color:#a23f3f;padding:10px 0;overflow-wrap:anywhere}.error button{margin-left:8px;background:none;border:0;text-decoration:underline;color:inherit}.menu{display:none}.section-view{padding:48px;max-width:800px}.section-view h2{font-size:25px;font-weight:500;letter-spacing:-.7px}.section-view p{color:#9199a6;margin:10px 0 25px;font-size:13px}.person-row{display:flex;align-items:center;gap:12px;padding:15px 0;border-bottom:1px solid #f0f1f4}.person-row strong{font-weight:500;font-size:13px}.person-row small{margin-left:auto;color:#969da9}.primary{background:#5485e7;color:#fff;border:0;border-radius:8px;padding:10px 17px;font-size:12px}.signin{width:100%;display:grid;place-items:center;background:#f8f9fb}.signin-card{width:min(380px,calc(100vw - 42px));padding:36px;background:#fff;border:1px solid #edf0f5;border-radius:18px}.signin-card .brand{padding:0;margin-bottom:35px}.signin h1{font-size:22px;letter-spacing:-.6px;font-weight:550}.signin p{font-size:12px;color:#969da9;margin:8px 0 25px}.signin label{display:flex;flex-direction:column;font-size:12px;gap:7px;margin:15px 0;color:#727b8b}.signin input{padding:10px 12px;border:1px solid #e1e5ec;border-radius:8px;background:white;color:#323b4a;width:100%}.signin form>.primary{width:100%;margin-top:10px}.signin .error{color:#a23f3f;margin-bottom:0}@media(min-width:1500px){.chat-column{padding-top:65px}}@media(max-width:700px){aside{position:fixed;inset:0 auto 0 0;z-index:30;box-shadow:10px 0 40px #17203920;transform:translateX(-105%);transition:transform .2s}aside.open{transform:translateX(0)}.menu{display:block;background:none;border:0;font-size:18px;color:#748095}.workspace>header{padding:0 18px;height:64px;justify-content:flex-start}.chat-column{padding:28px 20px 12px}.composer-area{padding:12px 16px max(14px,env(safe-area-inset-bottom))}.section-view{padding:30px 24px}.composer-footer>span{font-size:8px}.human .message-text{max-width:94%}}
.channels>button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;border-radius:7px;background:none;padding:8px 12px;font-size:12px;color:#828a99}.channels>button span{color:#a4aaba;font-size:16px}.channels>button.chosen{background:#e9edf4;color:#353c4b}.channels>p{font-size:10px;color:#a0a6b1;padding:0 10px}.channels .roster-title{margin-bottom:7px}.hash{color:#a5adba;font-size:19px;margin-right:4px}.bot-dispatch select{font-size:10px!important;border:0;background:transparent;color:#9099a9;max-width:200px;outline:none}
/* Adobe XD enterprise shell: quiet surfaces and compact proportions. */
aside{width:clamp(150px,15vw,194px);padding:20px 10px 14px;background:#f6f8fb;border-color:#edf0f6}
.company-pill{align-self:flex-start;max-width:100%;padding:8px 10px;margin:30px 0 26px;font-size:10px;font-weight:400;border-color:#e5ebf5;border-radius:9px;color:#263752}
nav{gap:3px}nav button{padding:7px 9px;gap:9px;font-size:11px;font-weight:400;color:#60718e;border-radius:6px}
nav button.chosen, .roster>button.selected{background:#eaf1ff;color:#275df4;font-weight:400}
.nav-icon{width:15px;height:15px}.roster-title{font-size:8px;letter-spacing:1.3px;font-weight:500;color:#617491;margin:24px 8px 12px}
.roster>button{padding:8px;gap:9px;min-height:45px}.roster strong{font-size:10px;font-weight:400;color:#24354f}.roster small{font-size:8px;color:#8190a8}
.account{padding:15px 3px 0;gap:7px}.account strong{font-size:9px;font-weight:400}.account small{font-size:8px}.account .user-avatar{border-radius:7px;width:25px;height:25px;font-size:9px}
.workspace>header{height:clamp(56px,8.8vh,72px);padding:0 26px;border-color:#edf0f6}.header-identity{gap:10px}.header-identity h1{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:400;color:#1f304a}.header-identity p{font-size:9px;margin-top:3px;color:#8794a9}
.presence{display:inline-flex;align-items:center;gap:4px;padding:3px 7px;border-radius:5px;background:#d9ffe3;color:#16843e;font-size:7px;font-weight:600;letter-spacing:.3px}.presence i{width:3px;height:3px;border-radius:50%;background:currentColor}.presence.busy{background:#eaf1ff;color:#3268ef}
.composer-area{padding:12px 26px 36px}.composer-column{width:min(100%,680px);max-width:68%;margin:0 auto}.composer{border:1px solid #dbe4f3;border-radius:13px;padding:13px 14px 10px;box-shadow:none}.composer textarea{min-height:39px;font-size:11px;line-height:1.7;color:#263752}.composer textarea::placeholder{color:#60718e}.composer-footer{min-height:24px}.send{width:25px;height:25px;font-size:18px;border-radius:7px;background:#3468f5}.send:disabled{opacity:1;background:#edf1f8;color:#a4b1c8;border:1px solid #d8e2f4}.file-toggle{font-size:19px;color:#7589a9;width:18px}.disclaimer{font-size:7px;color:#7e8da6;margin-top:10px}.chat-column{max-width:760px}.human .message-text{border-radius:15px;background:#f3f5f8}
@media(max-width:700px){.composer-column{max-width:100%}.composer-area{padding:12px 16px max(18px,env(safe-area-inset-bottom))}.workspace>header{padding:0 18px}.company-pill{margin-top:30px}}

.chat-actions{position:absolute;bottom:calc(100% + 10px);left:0;z-index:20;background:#fff;border:1px solid #e6ebf4;border-radius:12px;box-shadow:0 8px 30px #17243f0c;padding:6px;width:min(310px,100%)}.chat-actions button{display:block;width:100%;text-align:left;border:0;background:none;padding:10px 12px;border-radius:7px;font-size:12px;color:#17243f}.chat-actions button:hover{background:#f6f8fc}.chat-actions small{display:block;margin-top:3px;font-size:10px;color:#71809a}
.add-bot-button{border:0;background:none;font-size:17px;color:#71809a;line-height:1;padding:0 3px}.add-bot-link{text-align:left;border:0;background:none;font-size:10px;color:#71809a;padding:10px 8px;margin-bottom:16px}
.account{width:100%;border-right:0;border-left:0;border-bottom:0;background:none;text-align:left;cursor:pointer}.account:hover{background:#edf2fb;border-radius:8px}.account:focus-visible{outline:2px solid #9ab5ff;outline-offset:2px}
.account-area{position:relative}.account-popup{position:absolute;bottom:calc(100% + 8px);left:0;right:0;border:1px solid #e6ebf4;border-radius:9px;background:#fff;box-shadow:0 8px 30px #17243f12;padding:5px;z-index:35}.account-popup button{width:100%;display:block;padding:10px 12px;background:none;border:0;border-radius:6px;text-align:left;color:#17243f;font-size:12px}.account-popup button:hover{background:#f0f4fc}.account-more{margin-left:auto;color:#71809a;font-size:16px}.admin-eyebrow{font-size:9px!important;letter-spacing:1.4px;color:#71809a!important;margin:0 0 14px!important}.company-admin{width:100%;overflow:auto}.company-admin h2{margin:0}.admin-summary{display:flex;gap:28px;border:1px solid #e6ebf4;border-radius:10px;padding:20px;margin:25px 0}.admin-summary span{font-size:11px;color:#71809a}.admin-summary strong{font-size:22px;color:#17243f;display:block;font-weight:500;margin-bottom:4px}.admin-actions{display:grid;gap:10px;margin-bottom:30px}.admin-actions button{text-align:left;padding:17px;border:1px solid #e6ebf4;border-radius:10px;background:#fff;font-size:13px;color:#17243f}.admin-actions button:hover{background:#f6f8fc}.admin-actions span{display:block;margin-top:6px;font-size:11px;color:#71809a}.company-admin h3{font-size:13px;font-weight:500}.admin-caps{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}.admin-caps span{background:#f6f8fc;border:1px solid #e6ebf4;padding:5px 8px;border-radius:6px;font-size:10px;color:#71809a}
@font-face{font-family:'Starli Sans';src:url('/assets/fonts/Mona-Sans.woff2') format('woff2');font-weight:200 900;font-style:normal;font-display:swap}.enterprise{font-family:'Starli Sans',Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;font-feature-settings:'ss01' on,'cv11' on}.enterprise nav button{font-size:12px}.roster strong{font-size:11px}.roster small{font-size:9px}.channels>button{font-size:12px}.header-identity h1{font-size:13px}.header-identity p{font-size:10px}.composer textarea{font-size:13px}.account strong{font-size:11px}.account small{font-size:9px}
.open-panel-rail{display:flex;gap:6px;align-items:center;overflow:auto;padding:9px 26px;border-bottom:1px solid #edf0f6;flex:none}.open-panel-rail button{white-space:nowrap;border:1px solid #e6ebf4;border-radius:7px;background:#fff;padding:5px 9px;color:#71809a;font-size:10px}.open-panel-rail button.active{background:#eef3ff;color:#3466f6;border-color:#dce7ff}.open-panel-rail .minimize{margin-left:auto;border:0}
</style>

