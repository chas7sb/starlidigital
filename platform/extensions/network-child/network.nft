table inet starli_network_child {
 set denied4 {
  type ipv4_addr
  flags interval
  elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
   192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
   203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
 }
 chain search_network {
  ip daddr 127.0.0.53 udp dport 53 accept
  ip daddr 127.0.0.53 tcp dport 53 accept
  ip daddr 127.0.0.1 tcp dport 8888 accept
  ip daddr @denied4 reject
  ip protocol tcp tcp dport 443 accept
  reject
 }
 chain mcp_network {
  ip daddr 127.0.0.53 udp dport 53 accept
  ip daddr 127.0.0.53 tcp dport 53 accept
  ip daddr @denied4 reject
  ip protocol tcp tcp dport 443 accept
  reject
 }
 chain scoped_output {
  type filter hook output priority -20; policy accept;
  socket cgroupv2 level 2 "starli-network-children/search-v1" jump search_network
  socket cgroupv2 level 2 "starli-network-children/mcp-v1" jump mcp_network
 }
}
